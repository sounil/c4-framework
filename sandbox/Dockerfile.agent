FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl wget git ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*
# Trust the mitmproxy CA at container start (the CA volume is populated on the
# proxy's first run), then hand off to the requested command.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
RUN useradd -m agent && mkdir -p /work && chown agent /work
ENTRYPOINT ["/entrypoint.sh"]
