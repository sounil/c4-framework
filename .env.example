# Copy to .env and fill in what you use. `make` targets source this file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama's OpenAI-compatible endpoint (default shown). Start with: ollama serve && ollama pull <model>
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default model specs for `make run` (space separated). Use models you have access to.
#   anthropic:<model-id>   openai:<model-id>   ollama:<model-name>   scripted:<obedient|stubborn|zealot|random>
C4_MODELS=
C4_TRIALS=20
C4_CONCURRENCY=4
