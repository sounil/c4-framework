# Copy to .env and fill in what you use. The harness reads this file itself
# (experiments/env.py), so it applies to `make run` and to a direct
# `python -m experiments.run` alike. Anything already exported in your shell
# wins over what is written here.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama's OpenAI-compatible endpoint (default shown). Start with: ollama serve && ollama pull <model>
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# C4_MODELS - which models to run when `--models` is not passed.
#
# Format: one or more specs, SEPARATED BY SPACES. Each spec is
#
#     <provider>:<model-id>
#
# where <provider> is one of:
#
#     anthropic:<model-id>      e.g. anthropic:claude-sonnet-5
#     openai:<model-id>         e.g. openai:gpt-5.6-terra
#     ollama:<model-name>       e.g. ollama:llama3.1      (uses OLLAMA_BASE_URL)
#     scripted:<personality>    obedient | stubborn | zealot | random
#                               (deterministic mocks - no API key, smoke tests only)
#
# Quotes are optional and stripped either way; a trailing "# comment" is too.
# Commas do NOT separate specs: "anthropic:a,openai:b" is read as one model
# named "a,openai:b" and fails only when the API rejects it. Every spec needs
# its provider prefix - a bare "claude-sonnet-5" is rejected at startup.
#
# Examples:
#     C4_MODELS=anthropic:claude-sonnet-5
#     C4_MODELS=anthropic:claude-sonnet-5 openai:gpt-5.6-terra
#     C4_MODELS="anthropic:claude-opus-5 anthropic:claude-haiku-4-5-20251001 ollama:llama3.1"
#     C4_MODELS=scripted:zealot scripted:obedient          # key-free
# ---------------------------------------------------------------------------
C4_MODELS=anthropic:claude-sonnet-5 openai:gpt-5.6-terra

# Trials per cell (model x scenario x condition x Conscience level).
C4_TRIALS=20

# Parallel episodes. The Chassis is threaded; 4-16 is reasonable.
C4_CONCURRENCY=4
